class Solution {
public:
    int romanToInt(string s) {
      unordered_map<char, int> ht {{'A', 100000},{'I', 1},
      {'V', 5}, {'X', 10}, {'L',50},{'C',100},{'D',500},{'M',1000}};
      int ans = 0;
      char last_char = 'A';
      for(const char  c: s){
        if(ht[c] > ht[last_char]){
            ans -= 2*ht[last_char];
        }
        ans += ht[c];
        last_char = c;
      }
      return ans;
    }
};
